ANTHROPIC_API_KEY=your_key_here

# Banco durável (contas, sessões e análises). Sem ele, usa o SQLite local data/profiler.db.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Código de convite exigido para criar conta (recomendado em deploy público).
# SIGNUP_CODE=troque-este-codigo

# ALLOW_SIGNUP=0        # fecha o cadastro pela interface (use: python manage.py create-user)
# SESSION_TTL_DAYS=30   # duração do login no navegador
